VITE_API_BASE_URL=https://api.boxdiamonds.com/api/v1
VITE_SITE_URL=https://boxdiamonds.com

# Must match the backend's CASHFREE_ENV (PRODUCTION there = production here).
# A mismatch here is silent until checkout: Cashfree returns
# "payment_session_id_invalid" if the SDK's mode doesn't match the
# environment the session was actually created in.
VITE_CASHFREE_MODE=production
