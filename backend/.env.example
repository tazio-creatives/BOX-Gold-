NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://localhost:5432/box_diamonds_dev

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

ADMIN_SESSION_SECRET=change-me-in-production
ADMIN_SESSION_COOKIE_NAME=box_diamonds_admin_sid
ADMIN_SESSION_MAX_AGE_HOURS=12

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
ADMIN_LOGIN_RATE_LIMIT_MAX=10

CUSTOMER_SESSION_SECRET=change-me-in-production
CUSTOMER_SESSION_COOKIE_NAME=box_diamonds_customer_sid
CUSTOMER_SESSION_MAX_AGE_HOURS=720

GUEST_CART_SESSION_COOKIE_NAME=box_diamonds_cart_sid
GUEST_CART_SESSION_MAX_AGE_DAYS=90

# OTP_PROVIDER=stub logs the code to the console instead of sending a real SMS.
OTP_PROVIDER=stub
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_DAY=10
OTP_SEND_RATE_LIMIT_PER_IP=20

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# METAL_RATE_PROVIDER=stub returns a mock 24K rate instead of calling a real feed.
METAL_RATE_PROVIDER=stub
GOLD_RATE_SYNC_CRON="0 */6 * * *"

# Checkout / inventory reservation (Phase 10, plan §11)
RESERVATION_TTL_MINUTES=15
RESERVATION_SWEEP_CRON="* * * * *"
SHIPPING_ESTIMATE_MIN_DAYS=3
SHIPPING_ESTIMATE_MAX_DAYS=7

# Payment (Phase 11, plan §11)
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret

# Shipping (Phase 13, plan §11b)
SHIPPING_PROVIDER=stub
SHIPPING_WEBHOOK_SECRET=dev-only-shipping-webhook-secret

# Storage + AI image pipeline (Phase 15, plan §2/§9/§10)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
UPLOADS_PUBLIC_BASE_URL=http://localhost:4000/uploads
MAX_UPLOAD_SIZE_MB=10
AI_IMAGE_PROVIDER=stub
